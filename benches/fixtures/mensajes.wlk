class Personaje {
  property vida = 1000
  method recibirDanio(cantidad) { vida = vida - cantidad }
  method atacar(otro) { otro.recibirDanio(1) }
}

const goku = new Personaje()
const vegeta = new Personaje()
goku.atacar(vegeta)
vegeta.atacar(goku)
